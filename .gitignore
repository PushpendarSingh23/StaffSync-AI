# Root-level .gitignore — covers both server and client

# Dependencies
node_modules/
**/node_modules/

# Environment secrets — NEVER commit these
.env
**/.env
!**/.env.example
!**/.env.sample

# Build output
dist/
dist-ssr/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Uploaded files (keep directory structure, ignore actual files)
server/uploads/hr-documents/*.pdf

# Editor & OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

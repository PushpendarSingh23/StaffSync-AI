# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development   # Set to 'production' on Render/Railway

# ── Database ──────────────────────────────────────────────────────────────────
# Must be a MongoDB Atlas URI for Vector Search support
# Local MongoDB does NOT support $vectorSearch
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/EMS

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed client origins
ALLOWED_ORIGINS=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=7d

# ── Upload ────────────────────────────────────────────────────────────────────
# HR documents are stored in S3, not on local disk.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your-hr-documents-bucket
# In prod (e.g. ECS/EC2 with an IAM role) you can omit the two key vars
# above and let the AWS SDK pick up credentials from the instance role.

# ── AI / RAG ──────────────────────────────────────────────────────────────────
# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini chat model (gemini-1.5-flash is fast and cost-efficient)
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Name of the Atlas Vector Search index on the documentchunks collection
# Must match exactly what you created in the Atlas UI
MONGODB_VECTOR_INDEX=document_vector_index

# OCR fallback for scanned/image-based PDFs (optional — sensible defaults
# below). Only used when Node text extraction comes back too short.
# Minimum characters of Node-extracted text before OCR kicks in
OCR_MIN_TEXT_LENGTH=20
# Python executable to invoke for OCR (Docker image already has python3)
PYTHON_BIN=python3
